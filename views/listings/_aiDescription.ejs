<div class="mt-2">
  <button type="button" class="btn btn-outline-dark btn-sm" id="refine-description-button">
    Refine with AI
  </button>
</div>

<div id="ai-description-preview" class="border rounded p-3 mt-3" hidden>
  <label class="visually-hidden" for="ai-description-suggestion">Refined description</label>
  <textarea id="ai-description-suggestion" class="form-control" rows="5" readonly></textarea>
  <button type="button" class="btn btn-dark btn-sm" id="use-ai-description">Use refined description</button>
  <button type="button" class="btn btn-outline-secondary btn-sm ms-1" id="close-ai-preview">Close preview</button>
</div>

<script src="/js/ai-description.js" defer></script>
